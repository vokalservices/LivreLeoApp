generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  price       Float
  imageUrl    String
  author      String?
  ageGroup    String?
  metadata    String?
  lang        String    @default("fr")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orders      Order[]
  comments    Comment[]
}

model Order {
  id          Int      @id @default(autoincrement())
  product     Product  @relation(fields: [productId], references: [id])
  productId   Int
  amount      Float
  email       String?
  city        String?
  country     String?
  countryCode String?
  // Référence SasPay (transaction_id) — unicité côté base pour garantir
  // « livrer une seule fois » (webhook ET page /success convergent ici).
  saspayRef   String?  @unique
  createdAt   DateTime @default(now())
}

// Session de checkout SasPay persistée dès la création (guideline SKILL.md :
// « Persister le id/payment_id côté base dès la création »).
model SasPayCheckout {
  id          String   @id // id de session SasPay (UUID)
  orderRef    String   @unique // référence interne générée à la création
  slug        String?
  productId   String // "pack" | "combo" | id de tome
  basePrice   Float
  finalPrice  Float
  coupon      String?
  email       String
  phone       String?
  country     String?
  status      String   @default("PENDING") // PENDING | PAID | FAILED
  transactionId String?
  netAmount   Float?
  chargedAmount Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Comment {
  id        Int      @id @default(autoincrement())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  author    String
  email     String?
  body      String
  rating    Int      @default(5)
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model Coupon {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  type        String    @default("percent") // "percent" | "fixed"
  value       Float
  description String?
  active      Boolean   @default(true)
  usageLimit  Int? // null = illimité
  usageCount  Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
