# Ignore tout par défaut
*

# Sauf les dossiers de code et ressources web
!lib/
!pages/
!styles/
!components/
!prisma/
!public/

# Sauf les fichiers de configuration
!.gitignore
!.env.example
!package.json
!package-lock.json
!next.config.js
!tailwind.config.js
!postcss.config.js
!vercel.json
!GEMINI.md

# Autoriser les sous-dossiers et fichiers à l'intérieur
!**/
!**/*.js
!**/*.jsx
!**/*.ts
!**/*.tsx
!**/*.css
!**/*.json
!**/*.prisma
!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.svg
!**/*.ico
!**/*.webp

# Toujours ignorer
.vercel
.next/
.next/**
.venv/
.venv/**
node_modules/
node_modules/**
.env*
public/downloads/
public/downloads/**
projects/
projects/**
Projet_EN/
Projet_EN/**
push_temp/
push_temp/**
*.epub
*.mp3
*.log

